# Server Configuration
PORT=5000
NODE_ENV=development

# Database Configuration (PostgreSQL / Supabase)
DATABASE_URL="postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres"

# JWT Authentication
JWT_SECRET="your-super-secret-jwt-key-change-in-production"
JWT_EXPIRES_IN="7d"

# Teacher Seed Credentials (For initial database seeding)
TEACHER_CODE="TEACHER01"
TEACHER_NAME="Ms. Asmaa"
TEACHER_PASSWORD="your-strong-teacher-password"

# Frontend API base (Vite exposes only VITE_-prefixed vars to client code).
# Leave EMPTY in development — the Vite dev server proxies /api, /auth and
# /lessons to the Express backend. Set it for cross-origin production builds.
VITE_API_URL=
