# Server Configuration
PORT=5000
NODE_ENV=development

# Database Configuration (PostgreSQL / Supabase)
DATABASE_URL="postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres"

# JWT Authentication
JWT_SECRET="your-super-secret-jwt-key-change-in-production"
JWT_EXPIRES_IN="7d"

# Teacher Seed Credentials (For initial database seeding)
TEACHER_CODE="TEACHER01"
TEACHER_NAME="Ms. Asmaa"
TEACHER_PASSWORD="your-strong-teacher-password"

# Frontend API base for AUTH (Vite exposes only VITE_-prefixed vars to client code).
# Auth calls become ${VITE_API_URL}/auth/login and ${VITE_API_URL}/auth/signup.
# Content endpoints (videos/PDFs) stay same-origin (/api/...): proxied by Vite
# in dev, rewritten to the serverless function on Vercel.
VITE_API_URL=https://ms-asmaa.vercel.app/api/v1

# Password-reset email (SMTP). Never commit real credentials.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your-smtp-username
SMTP_PASS=your-smtp-password
MAIL_FROM="منصة المرسال <no-reply@example.com>"
# Public frontend origin used in password-reset links (no trailing slash).
FRONTEND_URL=https://ms-asmaa.vercel.app
