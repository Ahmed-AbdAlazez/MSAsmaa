# Server Configuration
PORT=5000
NODE_ENV=development

# Database Configuration (PostgreSQL / Supabase)
DATABASE_URL="postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres"

# JWT Authentication
JWT_SECRET="your-super-secret-jwt-key-change-in-production"
JWT_EXPIRES_IN="7d"

# Teacher Seed Credentials (For initial database seeding)
TEACHER_CODE="TEACHER01"
TEACHER_NAME="Ms. Asmaa"
TEACHER_PASSWORD="your-strong-teacher-password"

# Frontend API base for AUTH (Vite exposes only VITE_-prefixed vars to client code).
# Auth calls become ${VITE_API_URL}/auth/login and ${VITE_API_URL}/auth/signup.
# Content endpoints (videos/PDFs) stay same-origin (/api/...): proxied by Vite
# in dev, rewritten to the serverless function on Vercel.
VITE_API_URL=https://ms-asmaa.vercel.app/api/v1

# --------------------------------------------------------------------------
# Daily.co live-streaming (see LIVE_README.md for full setup instructions)
# --------------------------------------------------------------------------
# REQUIRED to go live: your Daily API key (Daily dashboard -> Developer -> API Keys).
# Without it the whole feature runs in STUB/dev mode (UI works end-to-end but
# creates no real rooms) so it can be built and tested first.
DAILY_API_KEY=
# Optional: your Daily subdomain, e.g. "myteam" for https://myteam.daily.co/...
# Defaults to the subdomain derived from DAILY_API_KEY when omitted.
DAILY_DOMAIN=
# Optional: namespace prefix for room names (avoids collisions). Default: msasmaa.
DAILY_ROOM_PREFIX=
