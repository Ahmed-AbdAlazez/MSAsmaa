# Server Configuration
PORT=5000
NODE_ENV=development

# Database Configuration (PostgreSQL / Supabase)
DATABASE_URL="postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres"

# JWT Authentication
JWT_SECRET="your-super-secret-jwt-key-change-in-production"
JWT_EXPIRES_IN="7d"

# Teacher Seed Credentials (For initial database seeding)
TEACHER_CODE="TEACHER01"
TEACHER_NAME="Ms. Asmaa"
TEACHER_PASSWORD="your-strong-teacher-password"

# Frontend API base for AUTH (Vite exposes only VITE_-prefixed vars to client code).
# Auth calls become ${VITE_API_URL}/auth/login and ${VITE_API_URL}/auth/signup.
# Content endpoints (videos/PDFs) stay same-origin (/api/...): proxied by Vite
# in dev, rewritten to the serverless function on Vercel.
VITE_API_URL=https://ms-asmaa.vercel.app/api/v1

# ===========================================================================
# LIVE STREAMING CREDENTIALS (ZOOM & GOOGLE MEET)
# ===========================================================================

# 1. Zoom (Server-to-Server OAuth App)
# Create app at https://marketplace.zoom.us/ (Server-to-Server OAuth)
ZOOM_ACCOUNT_ID="your_zoom_account_id"
ZOOM_CLIENT_ID="your_zoom_client_id"
ZOOM_CLIENT_SECRET="your_zoom_client_secret"

# 2. Google Meet (Google Cloud Console + Calendar API)
# Enable Google Calendar API & create OAuth 2.0 Credentials
GOOGLE_CLIENT_ID="your_google_client_id"
GOOGLE_CLIENT_SECRET="your_google_client_secret"
GOOGLE_REFRESH_TOKEN="your_google_refresh_token"

