{
  "functions": {
    "api/index.js": {
      "maxDuration": 60
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index"
    },
    { "source": "/index", "destination": "/index.html" },
    { "source": "/login", "destination": "/login.html" },
    { "source": "/forgot-password", "destination": "/forgot-password.html" },
    { "source": "/reset-password", "destination": "/reset-password.html" },
    { "source": "/courses", "destination": "/courses.html" },
    { "source": "/course-biology", "destination": "/course-biology.html" },
    { "source": "/lessons", "destination": "/lessons.html" },
    { "source": "/lesson-view", "destination": "/lesson-view.html" },
    { "source": "/exams", "destination": "/exams.html" },
    { "source": "/dashboard-teacher", "destination": "/dashboard-teacher.html" },
    { "source": "/registration-requests", "destination": "/registration-requests.html" },
    { "source": "/students", "destination": "/students.html" },
    { "source": "/student-mistakes", "destination": "/student-mistakes.html" },
    { "source": "/scoreboard", "destination": "/scoreboard.html" },
    { "source": "/live-session", "destination": "/live-session.html" },
    { "source": "/whiteboard", "destination": "/whiteboard.html" }
  ]
}
