{
  "name": "educational-platform-backend",
  "version": "1.0.0",
  "description": "Backend API for educational platform built with Node.js, Express, PostgreSQL, and Prisma",
  "main": "server.js",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "start": "node server.js",
    "dev": "concurrently -k -n api,web -c yellow,cyan \"npm run dev:api\" \"npm run dev:web\"",
    "dev:api": "nodemon server.js",
    "dev:web": "vite --host",
    "build": "vite build",
    "preview": "vite preview --host",
    "postinstall": "prisma generate",
    "start:auth": "node src/server.js",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:seed": "node prisma/seed.js",
    "seed:teacher": "node prisma/seed.js"
  },
  "prisma": {
    "seed": "node prisma/seed.js"
  },
  "keywords": [
    "nodejs",
    "express",
    "postgresql",
    "prisma",
    "mvc"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@napi-rs/canvas": "0.1.80",
    "@prisma/client": "^6.19.3",
    "@supabase/supabase-js": "^2.112.3",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "flatpickr": "^4.6.13",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.2.0",
    "pdf-lib": "1.17.1",
    "pdfjs-dist": "3.11.174"
  },
  "devDependencies": {
    "concurrently": "^10.0.5",
    "jsdom": "^30.0.1",
    "nodemon": "^3.1.9",
    "prisma": "^6.19.3",
    "vite": "^8.2.2"
  }
}
