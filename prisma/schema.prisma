// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  TEACHER
  STUDENT
}

enum Status {
  PENDING
  APPROVED
  REJECTED
}

model User {
  id                   String    @id @default(uuid())
  studentCode          String    @unique @map("student_code")
  name                 String
  password             String
  email                String?   @unique
  resetPasswordToken   String?   @map("reset_password_token")
  resetPasswordExpires DateTime? @map("reset_password_expires")
  role                 Role      @default(STUDENT)
  status               Status    @default(PENDING)
  createdAt            DateTime  @default(now()) @map("created_at")
  updatedAt            DateTime  @updatedAt @map("updated_at")

  notifications Notification[]

  @@index([role, status])
  @@map("users")
}

model Notification {
  id          String   @id @default(uuid())
  userId      String   @map("user_id")
  type        String
  title       String
  message     String
  relatedId   String?  @map("related_id")
  relatedType String?  @map("related_type")
  link        String?
  isRead      Boolean  @default(false) @map("is_read")
  createdAt   DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
  @@index([userId, createdAt])
  @@map("notifications")
}

model LessonMaterial {
  id          String   @id @default(uuid())
  lessonId    String   @map("lesson_id")
  title       String
  driveFileId String   @unique @map("drive_file_id")
  fileName    String   @map("file_name")
  mimeType    String   @map("mime_type")
  sizeBytes   BigInt?  @map("size_bytes")
  createdAt   DateTime @default(now()) @map("created_at")
  modifiedAt  DateTime @updatedAt @map("modified_at")

  @@index([lessonId, createdAt])
  @@map("lesson_materials")
}

// ---------------------------------------------------------------------------
// QUIZ FEATURE TABLES (added by the exams/quiz feature)
// NOTE for collaborators: everything below this line is OWNED BY THE QUIZ
// FEATURE. Nothing above was modified. quizId/studentId/lessonId are plain
// strings (no FK to users/lessons yet) because lessons/courses tables do not
// exist and attempt rows may reference JWT subjects that predate user rows.
// ---------------------------------------------------------------------------

/// One published exam. Times are absolute windows; durationMinutes is the
/// per-student countdown length (fractional allowed for tests).
model Quiz {
  id                 String   @id @default(uuid())
  createdByTeacherId String?  @map("created_by_teacher_id")
  lessonId           String?  @map("lesson_id")
  courseId           String?  @map("course_id")
  isMixed            Boolean  @default(false) @map("is_mixed")
  title              String
  questionCount      Int      @map("question_count")
  startTime          DateTime @map("start_time")
  endTime            DateTime @map("end_time")
  durationMinutes    Float    @map("duration_minutes")
  createdAt          DateTime @default(now()) @map("created_at")

  questions   QuizQuestion[]
  attempts    QuizAttempt[]
  quizLessons QuizLesson[]
  mistakes    StudentMistake[]

  @@index([courseId])
  @@index([lessonId])
  @@index([createdByTeacherId])
  @@map("quizzes")
}

/// Join table: which lessons a mixed quiz covers. Single-lesson quizzes
/// do NOT use this table — they just use Quiz.lessonId directly.
model QuizLesson {
  id       String @id @default(uuid())
  quizId   String @map("quiz_id")
  lessonId String @map("lesson_id")

  quiz Quiz @relation(fields: [quizId], references: [id], onDelete: Cascade)

  @@unique([quizId, lessonId])
  @@map("quiz_lessons")
}

/// A question inside a quiz. MCQs carry choices + correctChoiceId ("c1".."c4");
/// written questions carry modelAnswer only for later display (never graded).
model QuizQuestion {
  id              String  @id @default(uuid())
  quizId          String  @map("quiz_id")
  order           Int
  type            String
  text            String
  correctChoiceId String? @map("correct_choice_id")
  modelAnswer     String? @map("model_answer")
  imagePath       String? @map("image_path")

  quiz    Quiz         @relation(fields: [quizId], references: [id], onDelete: Cascade)
  choices QuizChoice[]
  mistakes StudentMistake[]

  @@unique([quizId, order])
  @@map("questions")
}

/// One MCQ option. `key` is the stable choice id students submit ("c1".."c4").
model QuizChoice {
  id         String @id @default(uuid())
  questionId String @map("question_id")
  key        String
  text       String

  question QuizQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([questionId, key])
  @@map("choices")
}

/// ONE ROW PER ATTEMPT — in-progress OR submitted (never both). Submitted rows
/// double as "quiz results": resultId used by review endpoints == attempt id.
model QuizAttempt {
  id               String    @id @default(uuid())
  quizId           String    @map("quiz_id")
  studentId        String    @map("student_id")
  attemptNumber    Int       @map("attempt_number")
  status           String    @default("in_progress")
  startedAt        DateTime  @default(now()) @map("started_at")
  personalDeadline DateTime  @map("personal_deadline")
  submittedAt      DateTime? @map("submitted_at")
  submissionReason String?   @map("submission_reason")
  score            Int?
  totalMcq         Int?      @map("total_mcq")
  /// Server-generated per-attempt shuffle (question + choice orders) so a
  /// resume replays the exact same arrangement. Null for legacy rows.
  ordering         Json?
  fullscreenExits  Int       @default(0) @map("fullscreen_exits")

  quiz    Quiz            @relation(fields: [quizId], references: [id], onDelete: Cascade)
  answers StudentAnswer[]
  mistakes StudentMistake[]

  @@index([quizId, studentId])
  @@index([quizId, status])
  @@index([studentId])
  @@map("quiz_attempts")
}

/// Autosaved answer for an in-progress attempt (one per question), enabling
/// resume-after-close. Late writes are ignored by the service once submitted.
model StudentAnswer {
  id         String   @id @default(uuid())
  attemptId  String   @map("attempt_id")
  questionId String   @map("question_id")
  value      String
  updatedAt  DateTime @updatedAt @map("updated_at")

  attempt QuizAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)

  @@unique([attemptId, questionId])
  @@map("student_answers")
}

/// One incorrect MCQ answer recorded for a specific student attempt.
model StudentMistake {
  id            String   @id @default(cuid())
  studentId     String   @map("student_id")
  quizId        String   @map("quiz_id")
  questionId    String   @map("question_id")
  attemptId     String   @map("attempt_id")
  studentAnswer String?  @map("student_answer")
  correctAnswer String   @map("correct_answer")
  createdAt     DateTime @default(now()) @map("created_at")

  quiz     Quiz         @relation(fields: [quizId], references: [id], onDelete: Cascade)
  question QuizQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
  attempt  QuizAttempt  @relation(fields: [attemptId], references: [id], onDelete: Cascade)

  @@unique([attemptId, questionId])
  @@index([studentId, createdAt])
  @@index([quizId])
  @@index([questionId])
  @@map("student_mistakes")
}

/// Teacher-granted ADDITIONAL attempts per (quiz, student). Allowance = 1 + extra_count.
model QuizExtraAttempt {
  id         String @id @default(uuid())
  quizId     String @map("quiz_id")
  studentId  String @map("student_id")
  extraCount Int    @default(0) @map("extra_count")

  @@unique([quizId, studentId])
  @@map("quiz_extra_attempts")
}

/// Lesson notes added dynamically by the teacher (Ms Asmaa) under a video.
model LessonNote {
  id        String   @id @default(uuid())
  lessonId  String   @map("lesson_id")
  content   String
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([lessonId])
  @@map("lesson_notes")
}

/// Labeled chapters/timestamps for uploaded videos (added for Adham's awareness).
model VideoChapter {
  id               String   @id @default(uuid())
  videoId          String   @map("video_id")
  title            String
  startTimeSeconds Int      @map("start_time_seconds")
  orderIndex       Int      @map("order_index")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  @@index([videoId])
  @@index([videoId, orderIndex])
  @@map("video_chapters")
}

/// Live streaming sessions started by teacher (Zoom or Google Meet).
model LiveSession {
  id          String   @id @default(uuid())
  title       String
  provider    String   // "zoom" or "google_meet"
  meetingId   String   @map("meeting_id")
  meetingUrl  String   @map("meeting_url")
  passcode    String?
  allowCamera Boolean  @default(false) @map("allow_camera")
  status      String   @default("active") // "active" | "ended"
  teacherId   String   @map("teacher_id")
  lessonId    String?  @map("lesson_id")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  tokens LiveSessionToken[]

  @@map("live_sessions")
}

/// Short-lived single-use access tokens for enrolled students joining live sessions.
model LiveSessionToken {
  id        String   @id @default(uuid())
  token     String   @unique
  sessionId String   @map("session_id")
  studentId String   @map("student_id")
  expiresAt DateTime @map("expires_at")
  used      Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at")

  session LiveSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([token])
  @@index([studentId, sessionId])
  @@map("live_session_tokens")
}

/// Stores lesson video metadata for YouTube and database-backed video entries.
model LessonVideo {
  id             String   @id @default(uuid())
  lessonId       String   @map("lesson_id")
  title          String
  description    String?
  attachmentUrl  String?  @map("attachment_url")
  videoSource    String   @default("bunny") @map("video_source") // "bunny" | "youtube"
  bunnyVideoId   String?  @map("bunny_video_id")
  youtubeVideoId String?  @map("youtube_video_id")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  @@index([lessonId])
  @@index([lessonId, videoSource])
  @@map("lesson_videos")
}

